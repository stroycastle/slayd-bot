# Bu faylni ".env" nomi bilan nusxalang va toʻldiring.

# Telegram bot tokeni (@BotFather beradi)
BOT_TOKEN=

# --- AI kaliti: bittasi yetadi ---
# Hozircha sinash uchun OpenRouter (openrouter.ai -> Keys; Credits boʻlimida hisobni toʻldiring)
OPENROUTER_API_KEY=
# Zaxira modellar (ixtiyoriy, vergul bilan): asosiy model band (429) yoki ishlamasa, navbat bilan shular sinab koʻriladi.
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free
# Qoʻshimcha OpenRouter kalitlari (ixtiyoriy): vergul, boʻshliq yoki yangi qator bilan. Birinchi kalitning puli tugasa,
# bot avtomatik keyingisiga oʻtadi va adminga xabar beradi.
# OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...
# OpenRouter modeli. Claude: anthropic/claude-sonnet-5.5 (sifatli), arzonroq variant: google/gemini-3.8-flash
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Keyinroq Claudening oʻz kaliti (console.anthropic.com -> API Keys).
# Shu qatorga kalit yozilsa, bot avtomatik Claudega oʻtadi (OpenRouter kaliti qolsa ham zarari yoʻq).
ANTHROPIC_API_KEY=
# Majburlab tanlash kerak boʻlsa: AI_PROVIDER=openrouter yoki AI_PROVIDER=anthropic
# AI_PROVIDER=

# Yangi maʼlumot: taqdimotdan oldin mavzu boʻyicha hozirgi manbalar olinadi (standart: yoqilgan, kalitsiz Vikipediya).
# Yaxshiroq natija uchun tavily.com dan bepul kalit oling (oyiga 1000 qidiruv) va shu yerga yozing. Oʻchirish: WEB_RESEARCH=0
# TAVILY_API_KEY=
# WEB_RESEARCH=1

# Sinash uchun: 1 boʻlsa AI ishlatilmaydi, tayyor namuna matn chiqadi (kalit va pul kerak emas)
MOCK_AI=0

# Admin Telegram ID lari, vergul bilan (ID ni bilish uchun botga /id deb yozing)
ADMIN_IDS=

# Toʻlov qabul qilinadigan karta
CARD_NUMBER="0000 0000 0000 0000"
CARD_HOLDER="ISM FAMILIYA"

# Narxlar (soʻmda)
# Butun taqdimot narxi (slayd soniga bogʻliq emas). 0 qilsangiz, slayd boshiga PRICE_SLIDE olinadi.
PRICE_DECK=5000
PRICE_SLIDE=5000
PRICE_EDIT=3000
MIN_TOPUP=10000

# Hosting uchun (kompyuterda kerak emas)
# WEBHOOK_URL=https://sizning-botingiz.onrender.com   (Renderda oʻzi beriladi, yozish shart emas)
# DISABLE_PDF=1    (xotirasi kichik serverda faqat .pptx yuborish)
# KEEP_ALIVE_MIN=5 (Renderda xizmat uxlab qolmasligi uchun oʻziga har 5 daqiqada soʻrov yuboradi; 0 — oʻchirish)

# Doimiy ombor (Supabase). Berilmasa, balans/profil/buyurtmalar faylda saqlanadi — Renderning bepul rejasida har restartda OʻCHADI.
# 1) supabase.com da loyiha oching, 2) SQL Editor ga docs/supabase.sql ni qoʻyib Run bosing,
# 3) Project Settings → API Keys dan URL va SERVER kalitini (secret / service_role) shu yerga yozing. Anon/publishable kalit YARAMAYDI.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=

# Mini App (veb-ilova). Renderda oʻzi yoqiladi (manzil Renderniki). Oʻchirish: WEBAPP=0
# Kompyuterda sinash: WEB_PORT=3000, ochiq https manzilni (tunnel) WEBAPP_URL ga yozing, DEV_AUTH=1 (hostingda YOQMANG, bot ishga tushmaydi)
# WEBAPP=1
# WEBAPP_URL=
# WEB_PORT=3000
# DEV_AUTH=0
# MAX_EXTRACT_BYTES=4194304

# Ixtiyoriy
# ANTHROPIC_MODEL=claude-sonnet-5-5
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
