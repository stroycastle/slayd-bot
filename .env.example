# Bu faylni ".env" nomi bilan nusxalang va toʻldiring.

# Telegram bot tokeni (@BotFather beradi)
BOT_TOKEN=

# --- AI kaliti: bittasi yetadi ---
# Hozircha sinash uchun OpenRouter (openrouter.ai -> Keys; Credits boʻlimida hisobni toʻldiring)
OPENROUTER_API_KEY=
# Qoʻshimcha OpenRouter kalitlari (ixtiyoriy): vergul, boʻshliq yoki yangi qator bilan. Birinchi kalitning puli tugasa,
# bot avtomatik keyingisiga oʻtadi va adminga xabar beradi.
# OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...
# OpenRouter modeli. Claude: anthropic/claude-sonnet-5.5 (sifatli), arzonroq variant: google/gemini-3.8-flash
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Keyinroq Claudening oʻz kaliti (console.anthropic.com -> API Keys).
# Shu qatorga kalit yozilsa, bot avtomatik Claudega oʻtadi (OpenRouter kaliti qolsa ham zarari yoʻq).
ANTHROPIC_API_KEY=
# Majburlab tanlash kerak boʻlsa: AI_PROVIDER=openrouter yoki AI_PROVIDER=anthropic
# AI_PROVIDER=

# Sinash uchun: 1 boʻlsa AI ishlatilmaydi, tayyor namuna matn chiqadi (kalit va pul kerak emas)
MOCK_AI=0

# Admin Telegram ID lari, vergul bilan (ID ni bilish uchun botga /id deb yozing)
ADMIN_IDS=

# Toʻlov qabul qilinadigan karta
CARD_NUMBER="0000 0000 0000 0000"
CARD_HOLDER="ISM FAMILIYA"

# Narxlar (soʻmda)
# Butun taqdimot narxi (slayd soniga bogʻliq emas). 0 qilsangiz, slayd boshiga PRICE_SLIDE olinadi.
PRICE_DECK=5000
PRICE_SLIDE=5000
PRICE_EDIT=3000
MIN_TOPUP=10000

# Hosting uchun (kompyuterda kerak emas)
# WEBHOOK_URL=https://sizning-botingiz.onrender.com   (Renderda oʻzi beriladi, yozish shart emas)
# DISABLE_PDF=1    (xotirasi kichik serverda faqat .pptx yuborish)

# Ixtiyoriy
# ANTHROPIC_MODEL=claude-sonnet-5-5
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
